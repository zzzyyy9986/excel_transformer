# Скопируйте в .env в корне проекта:
# cp .env.prod.example .env

# Сгенерируйте ключ:
# docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:CHANGE_ME

# Публичный URL сервера (без слэша в конце)
APP_URL=http://your-server-ip

# Относительный путь — nginx проксирует /api на backend
VITE_API_URL=/api

# Порт frontend (по умолчанию 80)
HTTP_PORT=80
