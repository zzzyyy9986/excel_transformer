# Скопируйте в .env в корне проекта:
# cp .env.prod.example .env

# Сгенерируйте ключ:
# docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:CHANGE_ME

# Внешние порты на хосте (если 80 занят — не используйте его)
FRONTEND_PORT=8080
BACKEND_PORT=8001

# Публичный URL frontend (без слэша в конце).
# Если frontend проксирует /api и /storage — укажите URL frontend-порта.
APP_URL=http://your-server-ip:8080

# URL API для браузера (вшивается в frontend при сборке):
#   /api                          — запросы через frontend (рекомендуется)
#   http://your-server-ip:8001/api — прямой доступ к backend
VITE_API_URL=/api
