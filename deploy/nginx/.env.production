# Пример .env для excel-transformer.djazavi.ru
# Скопируйте в корень проекта: cp deploy/nginx/.env.production .env

APP_KEY=base64:CHANGE_ME

APP_URL=http://excel-transformer.djazavi.ru
FRONTEND_PORT=8082
BACKEND_PORT=8001

# Запросы /api идут через frontend-контейнер (хостовый nginx -> :8082 -> backend)
VITE_API_URL=/api
